---
// Cloudflare serves this with a real 404 status (see wrangler.jsonc).
// Without it, unknown paths fall back to index.html with 200 (soft 404).
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Stanislav Hohulia" noindex>
  <p class="code">404</p>
  <h1>Page not found</h1>
  <p class="message">That link does not lead anywhere.</p>
  <a href="/" class="link primary">Go to homepage</a>
</BaseLayout>

<style>
  .code {
    font-size: 4rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.04em;
    color: #f97316;
    line-height: 1;
  }

  h1 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
  }

  .message {
    color: #a1a1aa;
    margin: 0 0 1.75rem;
    line-height: 1.6;
  }
</style>
