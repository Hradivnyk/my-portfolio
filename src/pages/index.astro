---
// Image optimization
import { Image } from "astro:assets";
import avatarImage from "../assets/avatar.webp";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Stanislav Hohulia — Full-stack Engineer</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
        padding: 2rem 1rem;
        background-color: #111111;
        color: #ffffff;
      }

      .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 480px;
        width: 100%;
      }

      .avatar {
        width: 9rem;
        height: 9rem;
        border-radius: 9999px;
        object-fit: cover;
        border: 3px solid #f97316;
        margin-bottom: 1.5rem;
        box-shadow: 0 0 24px rgba(249, 115, 22, 0.25);
      }

      h1 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 0.25rem;
        letter-spacing: -0.02em;
      }

      .title {
        font-size: 1rem;
        color: #f97316;
        font-weight: 600;
        margin: 0 0 1rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        font-size: 0.875rem;
      }

      .bio {
        font-size: 0.975rem;
        color: #a1a1aa;
        line-height: 1.6;
        margin: 0 0 0.75rem;
      }

      .location {
        font-size: 0.825rem;
        color: #71717a;
        margin: 0 0 2rem;
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        justify-content: center;
      }

      .link {
        color: #ffffff;
        text-decoration: none;
        border: 1px solid #f97316;
        padding: 0.45rem 1rem;
        border-radius: 0.375rem;
        transition: all 0.2s ease;
        font-size: 0.9rem;
        font-weight: 500;
      }

      .link:hover {
        background-color: #f97316;
        color: #111111;
        transform: translateY(-2px);
      }

      .link.primary {
        background-color: #f97316;
        color: #111111;
        font-weight: 600;
      }

      .link.primary:hover {
        background-color: #ea580c;
        border-color: #ea580c;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <Image
        src={avatarImage}
        alt="Stanislav Hohulia"
        class="avatar"
        width={144}
        height={144}
      />

      <h1>Stanislav Hohulia</h1>
      <p class="title">Full-stack Engineer</p>

      <p class="bio">
        2+ years building high-traffic web apps with Vue.js, React/Next.js, and
        Node.js. Worked on e-commerce systems with 3.7M+ monthly users.
      </p>

      <p class="location">Kyiv, Ukraine · Open to remote</p>

      <div class="links">
        <a href="/cv.pdf" target="_blank" class="link primary">CV</a>
        <a href="/lnkd" target="_blank" class="link">LinkedIn</a>
        <a href="/tg" target="_blank" class="link">Telegram</a>
        <a href="/code" target="_blank" class="link">GitHub</a>
        <a href="mailto:stashohulia@gmail.com" class="link">Email</a>
      </div>
    </div>
  </body>
</html>
