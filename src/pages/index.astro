---
// Image optimization
import { Image } from "astro:assets";
import avatarImage from "../assets/avatar.webp";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Stanislav Hohulia — Full-stack Engineer";
const description =
  "Full-stack engineer in Kyiv. 2+ years building high-traffic web apps with Vue.js, React/Next.js and Node.js, including e-commerce for 3.7M+ monthly users.";

// Profile URLs, direct rather than via the /lnkd, /code and /tg redirects:
// sameAs is how search engines tie the name to the accounts, so it should not
// depend on a hop of ours resolving.
const profiles = [
  "https://github.com/Hradivnyk",
  "https://www.linkedin.com/in/stanislav-hohulia/",
  "https://t.me/stanislavhohulia",
];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Stanislav Hohulia",
  url: new URL("/", Astro.site).href,
  image: new URL("/og.png", Astro.site).href,
  jobTitle: "Full-stack Engineer",
  email: "stashohulia@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kyiv",
    addressCountry: "UA",
  },
  knowsAbout: ["Vue.js", "React", "Next.js", "Node.js"],
  sameAs: profiles,
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="profile"
  ogImageAlt="Stanislav Hohulia, Full-stack Engineer"
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  />

  {/* priority, because Astro's Image defaults to loading="lazy" and this is the
      topmost element on the page — lazy defers the request until after layout,
      instead of letting the preload scanner start it during parsing. It is
      meant for one image per page, and this is the one. */}
  <Image
    src={avatarImage}
    alt="Stanislav Hohulia"
    class="avatar"
    width={144}
    height={144}
    densities={[1, 2, 3]}
    quality={90}
    priority
  />

  <h1>Stanislav Hohulia</h1>
  <p class="title">Full-stack Engineer</p>

  <p class="bio">
    2+ years building high-traffic web apps with Vue.js, React/Next.js, and
    Node.js. Worked on e-commerce systems with 3.7M+ monthly users.
  </p>

  <p class="location">Kyiv, Ukraine · Open to remote</p>

  <div class="links">
    <a href="/cv.pdf" target="_blank" class="link primary">CV</a>
    <a href="/lnkd" target="_blank" rel="me" class="link">LinkedIn</a>
    <a href="/tg" target="_blank" rel="me" class="link">Telegram</a>
    <a href="/code" target="_blank" rel="me" class="link">GitHub</a>
    <a href="mailto:stashohulia@gmail.com" class="link">Email</a>
  </div>
</BaseLayout>

<style>
  .avatar {
    width: 9rem;
    height: 9rem;
    border-radius: 9999px;
    object-fit: cover;
    border: 3px solid #f97316;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 24px rgba(249, 115, 22, 0.25);
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .title {
    font-size: 0.875rem;
    color: #f97316;
    font-weight: 600;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .bio {
    font-size: 0.975rem;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  /* #71717a on #111111 was 3.9:1 — below the 4.5:1 WCAG AA floor at this size. */
  .location {
    font-size: 0.825rem;
    color: #85858f;
    margin: 0 0 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    justify-content: center;
  }
</style>
